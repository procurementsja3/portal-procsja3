                    <button onClick={() => window.open('https://gemini.google.com/share/bb855352a1b5?skid=9cb71a1b-a104-4e9c-8c82-ec3fc4baee54', '_blank')} className={subNavItemClass(false)}><ClipboardList className="w-3.5 h-3.5 mr-2.5 opacity-70" /> Pengajuan Stock</button>
                    <button onClick={() => window.open('https://gemini.google.com/share/feffa9cb0342?skid=5f15b082-35c7-41ca-a7c4-afbc962d32d6', '_blank')} className={subNavItemClass(false)}><Droplet className="w-3.5 h-3.5 mr-2.5 opacity-70" /> Solar</button>
                    <button disabled className="w-full flex items-center pl-[52px] pr-4 py-2.5 rounded-xl text-left text-xs font-bold text-slate-600 cursor-not-allowed border-l-2 border-transparent"><Mountain className="w-3.5 h-3.5 mr-2.5 opacity-30" /> Batubara <span className="ml-auto text-[8px] bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded uppercase">Soon</span></button>
                    <button onClick={() => window.open('https://gemini.google.com/share/2d8ea2848468?skid=29b8de44-a656-441c-9a9c-7b42c6e5d9b7', '_blank')} className={subNavItemClass(false)}><Package className="w-3.5 h-3.5 mr-2.5 opacity-70" /> Pallet Kayu</button>
                    <button onClick={() => window.open('https://gemini.google.com/share/cc921c59e922', '_blank')} className={subNavItemClass(false)}><Truck className="w-3.5 h-3.5 mr-2.5 opacity-70" /> Kedatangan Barang</button>
                    <button disabled className="w-full flex items-center pl-[52px] pr-4 py-2.5 rounded-xl text-left text-xs font-bold text-slate-600 cursor-not-allowed border-l-2 border-transparent"><Wrench className="w-3.5 h-3.5 mr-2.5 opacity-30" /> Sparepart Bekas <span className="ml-auto text-[8px] bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded uppercase">Soon</span></button>
                  </div>
                )}
              </div>
              
              <div className="pt-2 border-t border-[#1e293b] mt-2">
                <span className="px-4 text-[10px] font-extrabold text-slate-500 uppercase tracking-widest block mb-2 mt-2">Arsip & Panduan</span>
                <button onClick={() => setIsDokumenOpen(!isDokumenOpen)} className={`w-full flex items-center justify-between px-4 py-3 rounded-xl transition-colors text-[13px] font-bold tracking-wide hover:bg-[#1e293b] text-slate-300`}>
                  <div className="flex items-center text-left"><Files className="w-4 h-4 mr-3 opacity-80" /> Dokumen Legal</div>
                  {isDokumenOpen ? <ChevronUp className="w-3.5 h-3.5 opacity-50" /> : <ChevronDown className="w-3.5 h-3.5 opacity-50" />}
                </button>
                {isDokumenOpen && (
                  <div className="mt-1 space-y-1">
                    <button onClick={() => setActiveTab('sop-wi')} className={subNavItemClass(activeTab === 'sop-wi')}><BookOpen className="w-3.5 h-3.5 mr-2.5 opacity-70 group-hover:opacity-100" /> SOP & Instruksi Kerja</button>
                    <button onClick={() => setActiveTab('form')} className={subNavItemClass(activeTab === 'form')}><FileText className="w-3.5 h-3.5 mr-2.5 opacity-70 group-hover:opacity-100" /> Form Standar</button>
                    <button onClick={() => setActiveTab('seleksi-supplier')} className={subNavItemClass(activeTab === 'seleksi-supplier')}><Users className="w-3.5 h-3.5 mr-2.5 opacity-70 group-hover:opacity-100" /> Seleksi Supplier</button>
                    <button onClick={() => setActiveTab('evaluasi-supplier')} className={subNavItemClass(activeTab === 'evaluasi-supplier')}><CheckCircle2 className="w-3.5 h-3.5 mr-2.5 opacity-70 group-hover:opacity-100" /> Evaluasi Supplier</button>
                    <button onClick={() => setActiveTab('backup-restore-dokumen')} className={subNavItemClass(activeTab === 'backup-restore-dokumen')}><Database className="w-3.5 h-3.5 mr-2.5 opacity-70 group-hover:opacity-100" /> Backup & Restore</button>
                  </div>
                )}
              </div>
            </div>
          )}
        </nav>
        
        <div className="absolute bottom-0 left-0 right-0 p-4 bg-[#0f172a] border-t border-[#1e293b]">
           <button onClick={handleLogout} className="w-full flex items-center justify-center px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-rose-500/10 hover:text-rose-400 text-slate-300 transition-colors border border-[#1e293b] hover:border-rose-500/20 text-xs font-bold tracking-wide"><LogOut className="w-4 h-4 mr-2" /> Akhiri Sesi</button>
        </div>
      </aside>

      <header className="md:hidden flex items-center justify-between px-5 py-4 bg-[#0f172a] border-b border-[#1e293b] z-10 shadow-sm text-white">
          <div className="flex items-center">
             <div className="w-8 h-8 bg-white rounded flex items-center justify-center mr-2 p-1 overflow-hidden shrink-0">
                {appLogo ? <img src={appLogo} alt="Logo" className="w-full h-full object-contain" /> : <ImageIcon className="w-4 h-4 text-slate-300" />}
             </div> 
             <span className="text-white font-extrabold text-sm tracking-tight">Portal SJA</span>
          </div>
          <button onClick={() => setIsMobileMenuOpen(true)} className="text-slate-300 p-1.5 border border-slate-700 rounded-lg hover:bg-slate-800"><Menu className="w-5 h-5" /></button>
      </header>

      {isMobileMenuOpen && (
        <div className="fixed inset-0 bg-[#0f172a]/80 z-50 md:hidden backdrop-blur-sm transition-opacity" onClick={() => setIsMobileMenuOpen(false)}>
          <aside className="w-[280px] h-full bg-[#0f172a] text-white flex flex-col shadow-2xl animate-in slide-in-from-left-full relative border-r border-[#1e293b]" onClick={e => e.stopPropagation()}>
            <div className="flex items-center justify-between h-20 border-b border-[#1e293b] px-5 bg-[#0f172a]">
              <div className="flex items-center">
                <div className="w-8 h-8 bg-white rounded flex items-center justify-center mr-2 shadow-lg shadow-white/10 p-1 overflow-hidden shrink-0">
                    {appLogo ? <img src={appLogo} alt="Logo" className="w-full h-full object-contain" /> : <ImageIcon className="w-4 h-4 text-slate-300" />}
                </div>
                <div className="flex flex-col"><span className="text-white font-extrabold text-sm tracking-tight">Portal Procurement</span></div>
              </div>
              <button onClick={() => setIsMobileMenuOpen(false)} className="text-slate-400 hover:text-white bg-slate-800 p-1.5 rounded-lg border border-slate-700"><X className="w-4 h-4" /></button>
            </div>
            
            <nav className="flex-1 overflow-y-auto py-6 px-3 space-y-1.5 pb-24">
              <button onClick={() => { setActiveTab('dashboard'); setIsMobileMenuOpen(false); }} className={navItemClass(activeTab === 'dashboard')}><LayoutDashboard className="w-4 h-4 mr-3" /> Dashboard Harga</button>
              <button onClick={() => { setActiveTab('input'); setIsMobileMenuOpen(false); }} className={navItemClass(activeTab === 'input')}><Database className="w-4 h-4 mr-3" /> Input Penawaran</button>
              <button onClick={() => { setActiveTab('update-pembelian'); setIsMobileMenuOpen(false); }} className={navItemClass(activeTab === 'update-pembelian')}><ShoppingCart className="w-4 h-4 mr-3" /> Dashboard G-Sheet</button>
              
              {userRole === 'admin' && (
                <>
                  <span className="px-4 text-[10px] font-extrabold text-slate-500 uppercase tracking-widest block mb-2 mt-4">Lainnya</span>
                  <button onClick={() => { setActiveTab('sop-wi'); setIsMobileMenuOpen(false); }} className={navItemClass(activeTab === 'sop-wi')}><BookOpen className="w-4 h-4 mr-3" /> SOP & Instruksi Kerja</button>
                  <button onClick={() => { setActiveTab('form'); setIsMobileMenuOpen(false); }} className={navItemClass(activeTab === 'form')}><FileText className="w-4 h-4 mr-3" /> Form Standar</button>
                  <button onClick={() => { setActiveTab('seleksi-supplier'); setIsMobileMenuOpen(false); }} className={navItemClass(activeTab === 'seleksi-supplier')}><Users className="w-4 h-4 mr-3" /> Seleksi Supplier</button>
                  <button onClick={() => { setActiveTab('evaluasi-supplier'); setIsMobileMenuOpen(false); }} className={navItemClass(activeTab === 'evaluasi-supplier')}><CheckCircle2 className="w-4 h-4 mr-3" /> Evaluasi Supplier</button>
                  <button onClick={() => { setActiveTab('backup-restore-dokumen'); setIsMobileMenuOpen(false); }} className={navItemClass(activeTab === 'backup-restore-dokumen')}><Database className="w-4 h-4 mr-3" /> Backup & Restore Dokumen</button>
                </>
              )}
            </nav>
            <div className="absolute bottom-0 left-0 right-0 p-4 border-t border-[#1e293b] bg-[#0f172a]">
               <button onClick={() => { handleLogout(); setIsMobileMenuOpen(false); }} className="w-full flex items-center justify-center px-4 py-2.5 rounded-xl bg-slate-800 text-slate-300 border border-slate-700 text-xs font-bold"><LogOut className="w-4 h-4 mr-2" /> Akhiri Sesi</button>
            </div>
          </aside>
        </div>
      )}

      <div className="flex-1 flex flex-col min-w-0 overflow-hidden bg-[#f8fafc]">
        <main className="flex-1 overflow-y-auto p-4 md:p-8 lg:px-10 relative scrollbar-thin scrollbar-thumb-slate-200">
          {activeTab === 'dashboard' ? (
            <DashboardView 
              data={data} 
              isLoading={isLoadingData} 
              onEdit={handleEditProject} 
              onDelete={handleDeleteProject} 
              sheetData={sheetData} 
              persistentFilters={persistentFilters}
              setPersistentFilters={setPersistentFilters}
            />
          ) : activeTab === 'input' ? (
            <InputDataView onAddData={handleAddData} isSaving={isSaving} data={data} editData={projectToEdit} onCancelEdit={() => { setProjectToEdit(null); setActiveTab('dashboard'); }} userRole={userRole} />
          ) : activeTab === 'sop-wi' ? (
            <DocumentManagerView user={user} userRole={userRole} docType="sop" />
          ) : activeTab === 'form' ? (
            <DocumentManagerView user={user} userRole={userRole} docType="form" />
          ) : activeTab === 'seleksi-supplier' ? (
            <DocumentManagerView user={user} userRole={userRole} docType="seleksi" />
          ) : activeTab === 'evaluasi-supplier' ? (
            <DocumentManagerView user={user} userRole={userRole} docType="evaluasi" />
          ) : activeTab === 'backup-restore-dokumen' ? (
            <GlobalDocumentBackupView user={user} userRole={userRole} />
          ) : (
            <UpdatePembelianView 
               sheetData={sheetData} 
               isLoading={isSheetLoading} 
               errorMsg={sheetErrorMsg} 
               availableMonths={sheetAvailableMonths} 
               availableYears={sheetAvailableYears} 
               fetchSheetData={fetchSheetData}
               persistentFilters={persistentFilters}
               setPersistentFilters={setPersistentFilters}
            />
          )}
        </main>
      </div>
      
    </div>
  );
}

        // Mount the App
        const root = createRoot(document.getElementById('root'));
        root.render(<PriceComparisonApp />);
    </script>
</body>
</html>
