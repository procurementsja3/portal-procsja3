            if (parts.length >= 2) { const pUnit = parts[parts.length - 1]; if (TIME_UNITS.includes(pUnit) && pUnit !== 'Lainnya') return { value: parts.slice(0, -1).join(' '), unit: pUnit, customUnit: '' }; }
            return { value: str, unit: 'Lainnya', customUnit: '' };
        };
        const parseTermBasic = (str) => {
          if (!str || str === '-') return { value: '', unit: 'Hari' };
