  const filteredSheetData = useMemo(() => {
     let filtered = sheetData || [];
     if (selectedYear !== 'all') filtered = filtered.filter(item => String(item.year).trim() === String(selectedYear).trim());
     
     if (selectedMonth !== 'all') {
         const monthParts = selectedMonth.split('-');
         if (monthParts.length > 1) {
             const monthNum = parseInt(monthParts[1], 10);
             const monthNames = { 
                 1: ['jan'], 2: ['feb'], 3: ['mar'], 4: ['apr'], 5: ['mei', 'may'], 6: ['jun'], 
                 7: ['jul'], 8: ['agu', 'aug', '8', '08'], 9: ['sep'], 10: ['okt', 'oct', '10'], 11: ['nov', 'nop', '11'], 12: ['des', 'dec', '12'] 
             };
             
             filtered = filtered.filter(item => {
                 if (!item.month) return false;
                 const itemMonthStr = String(item.month).toLowerCase().trim();
                 const targetNames = monthNames[monthNum] || [];
                 return targetNames.some(name => itemMonthStr.includes(name));
             });
         }
     }
     
     if (selectedPoCode !== 'all') {
         filtered = filtered.filter(item => String(item.source).toUpperCase().trim() === String(selectedPoCode).toUpperCase().trim());
     }
     
