<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Procurement - Standalone App</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Babel for transpiling JSX -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    
    <style>
        body { margin: 0; padding: 0; background-color: #0f172a; font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif; }
        
        /* Custom scrollbar for tailwind scrollbar-thin class */
        .scrollbar-thin::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .scrollbar-thin::-webkit-scrollbar-track {
            background: transparent;
        }
        .scrollbar-thin::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 20px;
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel" data-type="module">
        import React, { useState, useMemo, useEffect, useRef } from 'https://esm.sh/react@18.2.0';
        import { createRoot } from 'https://esm.sh/react-dom@18.2.0/client';
        import { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip as RechartsTooltip, Legend, ResponsiveContainer, PieChart, Pie, Cell, ComposedChart, Line } from 'https://esm.sh/recharts@2.12.2?deps=react@18.2.0,react-dom@18.2.0';
        
        import { 
          Trophy, TrendingDown, DollarSign, Calendar, Package, FileText, 
          LayoutDashboard, Database, Menu, X, Briefcase, PlusCircle, CheckCircle2,
          Trash2, Plus, Users, ShieldCheck, Loader2, FolderOpen,
          FolderSearch, Edit, AlertTriangle, Download, Upload, Search, ChevronLeft, 
          ChevronRight, PieChart as PieChartIcon, FileClock, ShoppingCart, 
          LogOut, ChevronDown, ChevronUp, Droplet, Layers, Truck, Activity, Files, BookOpen,
          Eye, ClipboardList, Mountain, Printer, ArrowUpDown, ArrowDown, ArrowUp, Archive, RefreshCw, ExternalLink, Image as ImageIcon, Wrench
        } from 'https://esm.sh/lucide-react@0.344.0?deps=react@18.2.0';
        
        import { initializeApp, getApps, getApp } from 'https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js';
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from 'https://www.gstatic.com/firebasejs/10.8.1/firebase-auth.js';
        import { getFirestore, doc, setDoc, deleteDoc, onSnapshot, collection } from 'https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js';

        const fallbackConfig = { apiKey: "dummy", authDomain: "dummy", projectId: "dummy" };
        const firebaseConfig = typeof __firebase_config !== 'undefined' && __firebase_config ? JSON.parse(__firebase_config) : fallbackConfig;
        const app = getApps().length === 0 ? initializeApp(firebaseConfig) : getApp();
        const auth = getAuth(app);
        const db = getFirestore(app);
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
        const safeAppId = appId.replace(/\//g, '_');

        const UNIT_OPTIONS = ["Pcs", "Unit", "Set", "LOT", "Lembar", "Lonjor", "Meter", "Kilogram", "Lainnya"];
        const TIME_UNITS = ["Hari", "Minggu", "Bulan", "Tahun"];
        const COLORS = ['#2563eb', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4', '#ec4899', '#14b8a6', '#f43f5e', '#a855f7'];
        const SPEND_SAVING_COLORS = ['#3b82f6', '#10b981']; 
        const HISTORI_PER_PAGE = 10;
        const RADIAN = Math.PI / 180;

        const formatCurrency = (amount) => {
          return new Intl.NumberFormat('id-ID', {
            style: 'currency', currency: 'IDR', minimumFractionDigits: 0, maximumFractionDigits: 0,
          }).format(amount || 0);
        };

        const formatMonthDisplay = (yyyyMm) => {
          if (yyyyMm === 'all') return 'Semua Bulan';
          const [year, month] = yyyyMm.split('-');
          const date = new Date(year, parseInt(month) - 1);
          return date.toLocaleDateString('id-ID', { month: 'long' });
        };

        const formatDateDisplay = (dateString) => {
          try {
            const date = new Date(dateString);
            return date.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
          } catch {
            return dateString;
          }
        };

        const renderCustomizedLabel = ({ cx, cy, midAngle, innerRadius, outerRadius, percent, name, payload }) => {
            const radius = innerRadius + (outerRadius - innerRadius) * 0.5;
            const x = cx + radius * Math.cos(-midAngle * RADIAN); const y = cy + radius * Math.sin(-midAngle * RADIAN);
            if (percent < 0.03) return null; 
            const shortName = (name || (payload && payload.name) || 'Unknown').substring(0, 15) + '...';
            return (
               <text x={x} y={y} fill="white" textAnchor="middle" dominantBaseline="central" fontSize="11" fontWeight="bold" style={{ textShadow: '1px 2px 4px rgba(0,0,0,0.8)' }}>
                  {`${(percent * 100).toFixed(1)}%`}
                  <tspan x={x} y={y + 14} fontSize="9" fill="rgba(255,255,255,0.8)">{shortName}</tspan>
               </text>
            );
        };

        const Custom3DBar = (props) => {
            const { fill, x, y, width, height } = props; const depth = 12;
            if (!height || height <= 0 || isNaN(height)) return null;
            return (
              <g>
                <polygon points={`${x},${y} ${x + width},${y} ${x + width + depth},${y - depth} ${x + depth},${y - depth}`} fill={fill} />
                <polygon points={`${x},${y} ${x + width},${y} ${x + width + depth},${y - depth} ${x + depth},${y - depth}`} fill="white" fillOpacity={0.25} />
                <polygon points={`${x + width},${y} ${x + width + depth},${y - depth} ${x + width + depth},${y + height - depth} ${x + width},${y + height}`} fill={fill} />
                <polygon points={`${x + width},${y} ${x + width + depth},${y - depth} ${x + width + depth},${y + height - depth} ${x + width},${y + height}`} fill="black" fillOpacity={0.15} />
                <rect x={x} y={y} width={width} height={height} fill={fill} />
              </g>
            );
        };

        const DashboardView = ({ data, isLoading, onEdit, onDelete, sheetData, persistentFilters, setPersistentFilters }) => {
          const [projectToDelete, setProjectToDelete] = useState(null);
          const [isDeleting, setIsDeleting] = useState(false);
          const [historyCurrentPage, setHistoryCurrentPage] = useState(1);
          const [savingSortOrder, setSavingSortOrder] = useState('none');
          const [pdfData, setPdfData] = useState(null);
          const [isRefreshing, setIsRefreshing] = useState(false);

          const selectedYear = persistentFilters.year;
          const selectedMonth = persistentFilters.month;
          const poCodeFilter = persistentFilters.poCode;
          const dashboardFilters = persistentFilters.tableSearch;

          const setSelectedYear = (val) => setPersistentFilters(prev => ({ ...prev, year: val }));
          const setSelectedMonth = (val) => setPersistentFilters(prev => ({ ...prev, month: val }));
          const setPoCodeFilter = (val) => setPersistentFilters(prev => ({ ...prev, poCode: val }));
          const setDashboardFilters = (val) => setPersistentFilters(prev => ({ ...prev, tableSearch: typeof val === 'function' ? val(prev.tableSearch) : val }));

          const hasActiveDashboardFilters = Object.values(dashboardFilters).some(val => val !== '');

          useEffect(() => {
            if (!document.getElementById('html2pdf-script')) {
              const script = document.createElement('script');
              script.id = 'html2pdf-script';
              script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
              document.body.appendChild(script);
            }
            if (!document.getElementById('html2canvas-script')) {
              const script = document.createElement('script');
              script.id = 'html2canvas-script';
              script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
              document.body.appendChild(script);
            }
            
            return () => {
               const pdfScript = document.getElementById('html2pdf-script');
               const canvasScript = document.getElementById('html2canvas-script');
               if (pdfScript) document.body.removeChild(pdfScript);
               if (canvasScript) document.body.removeChild(canvasScript);
            };
          }, []);

          const handleShowPdf = (projectName, reqNumber) => {
            const projectItems = data.filter(item => item.projectName === projectName && item.reqNumber === reqNumber);
            const summary = projectSummaryData.find(p => p.projectName === projectName && p.reqNumber === reqNumber);
            if (projectItems.length > 0 && summary) {
               setPdfData({ items: projectItems, summary: summary });
            }
          };

          const handleDownloadPdf = () => {
            const element = document.getElementById('pdf-content-area');
            if (element && window.html2pdf) {
                const opt = {
                  margin:       [0.4, 0.4, 0.4, 0.4], 
                  filename:     `Tabulasi_${pdfData.summary.reqNumber.replace(/\//g, '_')}.pdf`,
                  image:        { type: 'jpeg', quality: 1 },
                  html2canvas:  { scale: 2, useCORS: true },
                  jsPDF:        { unit: 'in', format: 'a4', orientation: 'landscape' }
                };
                window.html2pdf().set(opt).from(element).save();
            }
          };

          const handleDownloadJpg = () => {
            const element = document.getElementById('pdf-content-area');
            if (element && window.html2canvas) {
                window.html2canvas(element, { scale: 2, useCORS: true }).then(canvas => {
                    const link = document.createElement('a');
                    link.download = `Tabulasi_${pdfData.summary.reqNumber.replace(/\//g, '_')}.jpg`;
                    link.href = canvas.toDataURL('image/jpeg', 1.0);
                    link.click();
                });
            }
          };

          const confirmDelete = async () => {
            if (projectToDelete) {
              setIsDeleting(true);
              await onDelete(projectToDelete.projectName, projectToDelete.reqNumber);
              setIsDeleting(false);
              setProjectToDelete(null);
            }
          };

          const availableYears = useMemo(() => {
            const years = new Set();
            data.forEach(item => { if (item.date) years.add(item.date.substring(0, 4)); });
            
            if (sheetData && sheetData.length > 0) {
                sheetData.forEach(item => { if (item.year) { years.add(String(item.year).trim()); } });
            }
            
            if (years.size === 0) { years.add(String(new Date().getFullYear())); }
            return Array.from(years).sort((a, b) => b.localeCompare(a));
          }, [data, sheetData]);

          const availableMonths = useMemo(() => {
            if (selectedYear === 'all') return [];
            const months = new Set();
            data.forEach(item => { if (item.date && item.date.startsWith(selectedYear)) months.add(item.date.substring(0, 7)); });
            return Array.from(months).sort((a, b) => b.localeCompare(a));
          }, [data, selectedYear]);

          const filteredData = useMemo(() => {
            let filtered = data;
            if (selectedYear !== 'all') filtered = filtered.filter(item => item.date && item.date.startsWith(selectedYear));
            if (selectedMonth !== 'all') filtered = filtered.filter(item => item.date && item.date.startsWith(selectedMonth));
            if (poCodeFilter === '4M') filtered = filtered.filter(item => item.poNumber && item.poNumber.toUpperCase().includes('4M'));
            else if (poCodeFilter === '4T') filtered = filtered.filter(item => item.poNumber && item.poNumber.toUpperCase().includes('4T'));
            return filtered;
          }, [data, selectedYear, selectedMonth, poCodeFilter]);

          const processedData = useMemo(() => {
            return filteredData.map(item => {
              const calculatedBids = item.bids.map(bid => ({ ...bid, totalPrice: bid.price * item.qty }));
              return { ...item, calculatedBids };
            });
          }, [filteredData]);

          const projectSummaryData = useMemo(() => {
            const grouped = {};
            processedData.forEach(item => {
              const pName = item.projectName || 'Tanpa Nama Project';
              const reqNum = item.reqNumber || 'NO-REQ';
              const key = reqNum + '-' + pName;

              if (!grouped[key]) {
                grouped[key] = { id: key, reqNumber: item.reqNumber || '-', projectName: pName, poNumber: item.poNumber || '-', date: item.date, timestamp: item.timestamp || parseInt(item.id) || 0, itemCount: 0, suppliers: new Map() };
              } else {
                const itemTime = item.timestamp || parseInt(item.id) || 0;
                if (itemTime > grouped[key].timestamp) grouped[key].timestamp = itemTime;
              }
              
              grouped[key].itemCount += 1;
              if (item.poNumber && item.poNumber !== '-') grouped[key].poNumber = item.poNumber;
              
              item.calculatedBids.forEach(bid => {
                  if (bid.totalPrice > 0) {
                      const currentTotal = grouped[key].suppliers.get(bid.supplier) || 0;
                      grouped[key].suppliers.set(bid.supplier, currentTotal + bid.totalPrice);
                  }
              });
            });

            return Object.values(grouped).map(proj => {
              let supplierList = Array.from(proj.suppliers.entries()).map(([name, totalValue]) => ({ name, totalValue })).sort((a, b) => a.totalValue - b.totalValue);
              const grandWinner = supplierList.length > 0 ? supplierList[0].name : '-';
              const grandWinnerPrice = supplierList.length > 0 ? supplierList[0].totalValue : 0;
              let baselinePrice = 0, totalSavingCost = 0, savingPercentage = 0;
              
              if (supplierList.length > 1) {
                  const losingBids = supplierList.slice(1);
                  const sumLosingBids = losingBids.reduce((sum, bid) => sum + bid.totalValue, 0);
                  baselinePrice = sumLosingBids / losingBids.length;
                  totalSavingCost = baselinePrice - grandWinnerPrice;
                  savingPercentage = ((totalSavingCost / baselinePrice) * 100).toFixed(2);
              } else { baselinePrice = grandWinnerPrice; }

              return { ...proj, supplierRanks: supplierList, grandWinner, totalSavingCost, savingPercentage, baselinePrice };
            }).sort((a, b) => {
                 const dateA = new Date(a.date).getTime();
                 const dateB = new Date(b.date).getTime();
                 if (dateB === dateA) return (b.timestamp || 0) - (a.timestamp || 0);
                 return dateB - dateA;
            });
          }, [processedData]);

          const filteredSheetData = useMemo(() => {
             let filtered = sheetData || [];
             
             if (selectedYear !== 'all') {
                 filtered = filtered.filter(item => String(item.year).trim() === String(selectedYear).trim());
             }
             
             if (selectedMonth !== 'all') {
                 const monthParts = selectedMonth.split('-');
                 if (monthParts.length > 1) {
                     const monthNum = parseInt(monthParts[1], 10);
                     const monthNames = { 
                         1: ['jan'], 2: ['feb'], 3: ['mar'], 4: ['apr'], 5: ['mei', 'may'], 6: ['jun'], 
                         7: ['jul'], 8: ['agu', 'aug', '8', '08'], 9: ['sep'], 10: ['okt', 'oct', '10'], 11: ['nov', 'nop', '11'], 12: ['des', 'dec', '12'] 
                     };
                     
                     filtered = filtered.filter(item => {
                         if (!item.month) return false;
                         const itemMonthStr = String(item.month).toLowerCase().trim();
                         const targetNames = monthNames[monthNum] || [];
                         return targetNames.some(name => itemMonthStr.includes(name));
                     });
                 }
             }
             
             if (poCodeFilter !== 'all') {
                 filtered = filtered.filter(item => String(item.source).toUpperCase().trim() === String(poCodeFilter).toUpperCase().trim());
             }
             
             return filtered;
          }, [sheetData, selectedYear, selectedMonth, poCodeFilter]);

          const mirroredTotalSpend = useMemo(() => {
             return filteredSheetData.reduce((acc, curr) => acc + (Number(curr.total) || 0), 0);
          }, [filteredSheetData]);

          const totalSavingCost = projectSummaryData.reduce((acc, curr) => acc + curr.totalSavingCost, 0);
          const baselinePriceCalc = mirroredTotalSpend + totalSavingCost;
          const overallSavingPercentage = baselinePriceCalc > 0 ? ((totalSavingCost / baselinePriceCalc) * 100).toFixed(2) : 0;

          const spendVsSavingData = useMemo(() => {
              return [
                  { name: 'Total Pengeluaran', value: mirroredTotalSpend },
                  { name: 'Total Saving Cost', value: totalSavingCost }
              ];
          }, [mirroredTotalSpend, totalSavingCost]);
          
          const totalPieValue = mirroredTotalSpend + totalSavingCost;

          const paretoData = useMemo(() => {
             const supplierSpend = {};
             filteredSheetData.forEach(item => { if(item.vendor && item.vendor !== 'Tanpa Item') supplierSpend[item.vendor] = (supplierSpend[item.vendor] || 0) + (Number(item.total) || 0); });
             const sorted = Object.keys(supplierSpend).map(key => ({ name: key, spend: supplierSpend[key] })).sort((a, b) => b.spend - a.spend);
             const totalAllSpend = sorted.reduce((sum, item) => sum + item.spend, 0);
             let currentSum = 0;
             return sorted.slice(0, 10).map(item => {
                 currentSum += item.spend;
                 return { ...item, cumulativePercentage: totalAllSpend > 0 ? Number(((currentSum / totalAllSpend) * 100).toFixed(2)) : 0 };
             });
          }, [filteredSheetData]);

          const savingParetoData = useMemo(() => {
             const supplierSavings = {};
             projectSummaryData.forEach(proj => {
                 if (proj.grandWinner !== '-' && proj.totalSavingCost > 0) supplierSavings[proj.grandWinner] = (supplierSavings[proj.grandWinner] || 0) + proj.totalSavingCost;
             });
             const sorted = Object.keys(supplierSavings).map(key => ({ name: key, saving: supplierSavings[key] })).sort((a, b) => b.saving - a.saving);
             const totalAllSaving = sorted.reduce((sum, item) => sum + item.saving, 0);
             let currentSum = 0;
             return sorted.slice(0, 10).map(item => {
                 currentSum += item.saving;
                 return { ...item, cumulativePercentage: totalAllSaving > 0 ? Number(((currentSum / totalAllSaving) * 100).toFixed(2)) : 0 };
             });
          }, [projectSummaryData]);

          const filteredProjectSummaryData = useMemo(() => {
            let result = [...projectSummaryData];
            if (dashboardFilters.reqNumber.trim()) result = result.filter(proj => (proj.reqNumber || '').toLowerCase().includes(dashboardFilters.reqNumber.toLowerCase()));
            if (dashboardFilters.project.trim()) result = result.filter(proj => (proj.projectName || '').toLowerCase().includes(dashboardFilters.project.toLowerCase()));
            if (dashboardFilters.date.trim()) result = result.filter(proj => formatDateDisplay(proj.date).toLowerCase().includes(dashboardFilters.date.toLowerCase()) || (proj.date || '').includes(dashboardFilters.date));
            if (dashboardFilters.poNumber.trim()) result = result.filter(proj => (proj.poNumber || '').toLowerCase().includes(dashboardFilters.poNumber.toLowerCase()));
            if (dashboardFilters.vendor.trim()) result = result.filter(proj => proj.supplierRanks.some(s => s.name.toLowerCase().includes(dashboardFilters.vendor.toLowerCase())) || (proj.grandWinner || '').toLowerCase().includes(dashboardFilters.vendor.toLowerCase()));
            if (savingSortOrder === 'desc') result.sort((a, b) => b.totalSavingCost === a.totalSavingCost ? new Date(b.date).getTime() - new Date(a.date).getTime() : b.totalSavingCost - a.totalSavingCost);
            else if (savingSortOrder === 'asc') result.sort((a, b) => a.totalSavingCost === b.totalSavingCost ? new Date(b.date).getTime() - new Date(a.date).getTime() : a.totalSavingCost - b.totalSavingCost);
            return result;
          }, [projectSummaryData, dashboardFilters, savingSortOrder]);

          const ITEMS_PER_PAGE = 10;
          const paginatedProjects = filteredProjectSummaryData.slice((historyCurrentPage - 1) * ITEMS_PER_PAGE, historyCurrentPage * ITEMS_PER_PAGE);
          const totalPages = Math.ceil(filteredProjectSummaryData.length / ITEMS_PER_PAGE);
          
          useEffect(() => { setHistoryCurrentPage(1); }, [dashboardFilters]);

          const handleRefresh = () => {
            setIsRefreshing(true);
            setTimeout(() => setIsRefreshing(false), 800);
          };

          return (
            <div className="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-300">
              
              <div className="flex flex-col md:flex-row justify-between items-start md:items-center mb-4 gap-4 bg-white p-5 rounded-2xl shadow-[0_2px_12px_-4px_rgba(0,0,0,0.04)] border border-slate-200/60">
                <div>
                  <h1 className="text-2xl font-bold text-slate-800 tracking-tight">Summary Dashboard</h1>
                  <p className="text-sm text-slate-500 font-medium mt-0.5">Analisis Komparasi Harga & Saving Cost</p>
                </div>
                <div className="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
                  <select value={poCodeFilter} onChange={(e) => setPoCodeFilter(e.target.value)} className="w-full sm:w-auto pl-4 pr-8 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/50 appearance-none cursor-pointer hover:bg-slate-100 transition-colors bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M7%2010L12%2015L17%2010%22%20stroke%3D%22%2364748B%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] bg-[position:right_8px_center] bg-no-repeat">
                    <option value="all">Semua Kode PO</option>
                    <option value="4M">PO Kode 4M</option>
                    <option value="4T">PO Kode 4T</option>
                  </select>
                  <select value={selectedYear} onChange={(e) => { setSelectedYear(e.target.value); setSelectedMonth('all'); }} className="w-full sm:w-auto pl-4 pr-8 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/50 appearance-none cursor-pointer hover:bg-slate-100 transition-colors bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M7%2010L12%2015L17%2010%22%20stroke%3D%22%2364748B%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] bg-[position:right_8px_center] bg-no-repeat">
                    <option value="all">Semua Tahun</option>
                    {availableYears.map(y => <option key={y} value={y}>{y}</option>)}
                  </select>
                  <select value={selectedMonth} onChange={(e) => setSelectedMonth(e.target.value)} disabled={selectedYear === 'all'} className="w-full sm:w-auto pl-4 pr-8 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/50 appearance-none cursor-pointer hover:bg-slate-100 disabled:opacity-50 transition-colors bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M7%2010L12%2015L17%2010%22%20stroke%3D%22%2364748B%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] bg-[position:right_8px_center] bg-no-repeat">
                    <option value="all">{selectedYear === 'all' ? 'Pilih Tahun Dahulu' : 'Semua Bulan'}</option>
                    {availableMonths.map(m => <option key={m} value={m}>{formatMonthDisplay(m)}</option>)}
                  </select>
                </div>
              </div>

              {}
              <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
                <div className="bg-white rounded-2xl p-6 shadow-[0_2px_12px_-4px_rgba(0,0,0,0.04)] border border-slate-200/60 relative overflow-hidden group hover:border-blue-200 transition-colors flex flex-col justify-between">
                  <div className="absolute top-0 right-0 p-4 opacity-5 group-hover:opacity-10 transition-opacity"><DollarSign className="w-24 h-24 text-blue-600" /></div>
                  <div className="relative z-10 flex flex-col justify-between h-full">
                    <div className="flex items-center text-slate-500 text-sm font-semibold mb-2"><DollarSign className="w-4 h-4 mr-1.5" /> Total Pengeluaran</div>
