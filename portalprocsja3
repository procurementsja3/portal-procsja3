const DocumentManagerView = ({ user, userRole, docType }) => {
  const [documents, setDocuments] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const [isUploading, setIsUploading] = useState(false);
  const [titleInput, setTitleInput] = useState('');
  const [selectedFile, setSelectedFile] = useState(null);
  const fileInputRef = useRef(null);
  const [notification, setNotification] = useState({ show: false, message: '', type: 'info' });
  const [tableFilters, setTableFilters] = useState({ nama: '', format: '', tanggal: '' });
  const hasActiveFilters = Object.values(tableFilters).some(val => val !== '');

  let pageTitle = '';
  let pageIcon = null;
  if (docType === 'form') {
      pageTitle = 'Manajemen FORM';
      pageIcon = <FileText className="w-5 h-5 text-blue-600" />;
  } else if (docType === 'seleksi') {
      pageTitle = 'Seleksi Supplier';
      pageIcon = <Users className="w-5 h-5 text-blue-600" />;
  } else if (docType === 'evaluasi') {
      pageTitle = 'Evaluasi Supplier';
      pageIcon = <CheckCircle2 className="w-5 h-5 text-emerald-600" />;
  } else {
      pageTitle = 'Work Instruction (WI) & SOP';
      pageIcon = <BookOpen className="w-5 h-5 text-blue-600" />;
  }

  useEffect(() => {
    if (!user) return;
    setIsLoading(true);
    const docsRef = collection(db, 'artifacts', safeAppId, 'public', 'data', 'documents');
    const unsubscribe = onSnapshot(docsRef, (snapshot) => {
      const fetchedData = snapshot.docs.map(doc => ({ ...doc.data(), id: doc.id })).filter(doc => doc.docType === docType);
      fetchedData.sort((a, b) => b.uploadDate - a.uploadDate); setDocuments(fetchedData); setIsLoading(false);
    }, () => setIsLoading(false));
    return () => unsubscribe();
  }, [user, docType]);

  const showNotification = (message, type = 'success') => { setNotification({ show: true, message, type }); setTimeout(() => setNotification({ show: false, message: '', type: 'info' }), 4000); };

  const handleFileChange = (e) => {
    const file = e.target.files[0]; if (!file) return;
    if (file.size > 1048576) { showNotification("Ukuran file melebihi 1 MB.", "error"); fileInputRef.current.value = ''; setSelectedFile(null); return; }
    setSelectedFile(file);
  };

  const handleUpload = async (e) => {
    e.preventDefault();
    if (!user || userRole !== 'admin') return showNotification("Akses ditolak.", "error");
    if (!titleInput.trim() || !selectedFile) return showNotification("Isi judul & pilih file.", "error");
    setIsUploading(true);
    try {
      const reader = new FileReader();
      reader.readAsDataURL(selectedFile);
      reader.onload = async () => {
        const newDoc = { id: Date.now().toString(), docType: docType, title: titleInput, fileName: selectedFile.name, fileType: selectedFile.type, fileSize: selectedFile.size, uploadDate: Date.now(), uploader: 'Admin SJA', fileData: reader.result };
        await setDoc(doc(db, 'artifacts', safeAppId, 'public', 'data', 'documents', newDoc.id), newDoc);
        showNotification("Dokumen berhasil di-upload!", "success"); setTitleInput(''); setSelectedFile(null); fileInputRef.current.value = '';
      };
    } catch (error) { showNotification("Gagal upload.", "error"); } finally { setIsUploading(false); }
  };

  const handleDelete = async (docId, docTitle) => {
    if (!user || userRole !== 'admin') return;
    if (window.confirm(`Hapus dokumen "${docTitle}"?`)) { await deleteDoc(doc(db, 'artifacts', safeAppId, 'public', 'data', 'documents', docId)); showNotification("Dokumen dihapus.", "success"); }
  };

  const filteredDocs = documents.filter(d => {
    const dateStr = new Date(d.uploadDate).toLocaleDateString('id-ID');
    return d.title.toLowerCase().includes(tableFilters.nama.toLowerCase()) && d.fileName.toLowerCase().includes(tableFilters.format.toLowerCase()) && (dateStr.includes(tableFilters.tanggal) || d.uploader.toLowerCase().includes(tableFilters.tanggal.toLowerCase()));
  });

  return (
    <div className="max-w-6xl mx-auto animate-in fade-in duration-300 pb-12">
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4 bg-white p-5 rounded-2xl shadow-[0_2px_12px_-4px_rgba(0,0,0,0.04)] border border-slate-200/60">
        <div className="flex items-center">
          <div className="p-3 bg-blue-50 rounded-xl mr-3 border border-blue-100 shadow-sm">{pageIcon}</div>
          <div><h1 className="text-xl font-bold text-slate-800 tracking-tight">{pageTitle}</h1><p className="text-xs text-slate-500 font-medium mt-0.5">Kelola referensi. Maks 1 MB.</p></div>
        </div>
      </div>
      {notification.show && <div className={`mb-6 p-4 rounded-xl flex items-center shadow-sm border animate-in fade-in ${notification.type === 'success' ? 'bg-emerald-50 text-emerald-800 border-emerald-100' : 'bg-rose-50 text-rose-800 border-rose-100'}`}><span className="font-semibold text-sm">{notification.message}</span></div>}

      {userRole === 'admin' && (
        <div className="bg-white rounded-2xl shadow-[0_2px_12px_-4px_rgba(0,0,0,0.04)] border border-slate-200/60 mb-6 overflow-hidden">
          <div className="px-6 py-4 border-b border-slate-100"><h2 className="text-sm font-bold text-slate-800 flex items-center tracking-tight"><Upload className="w-4 h-4 mr-2 text-blue-600" /> Upload Dokumen Baru</h2></div>
          <form onSubmit={handleUpload} className="p-6">
            <div className="flex flex-col md:flex-row gap-5 items-end">
              <div className="flex-1 w-full"><label className="block text-[11px] font-bold text-slate-500 uppercase tracking-widest mb-1.5">Judul</label><input type="text" required value={titleInput} onChange={(e) => setTitleInput(e.target.value)} className="w-full px-4 py-2.5 bg-slate-50/50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-blue-500/20 font-medium text-sm" /></div>
              <div className="flex-1 w-full"><label className="block text-[11px] font-bold text-slate-500 uppercase tracking-widest mb-1.5">File</label><input type="file" required ref={fileInputRef} onChange={handleFileChange} className="w-full px-3 py-2 border border-slate-200 bg-slate-50/50 rounded-xl text-sm" /></div>
              <button type="submit" disabled={isUploading} className="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold transition-all shadow-[0_4px_12px_rgba(37,99,235,0.2)] text-sm">{isUploading ? 'Loading...' : 'Upload'}</button>
            </div>
          </form>
        </div>
      )}

      <div className="bg-white rounded-2xl shadow-[0_2px_12px_-4px_rgba(0,0,0,0.04)] border border-slate-200/60 overflow-hidden">
        <div className="px-6 py-4 border-b border-slate-100 bg-white flex justify-between items-center">
            <h2 className="text-sm font-bold text-slate-800 flex items-center tracking-tight"><Database className="w-4 h-4 mr-2 text-slate-400" /> Daftar ({filteredDocs.length})</h2>
            {hasActiveFilters && (
                <button type="button" onClick={() => setTableFilters({ nama: '', format: '', tanggal: '' })} className="text-[11px] text-rose-600 hover:text-rose-700 font-bold px-3 py-1.5 border border-rose-200 bg-rose-50 rounded-lg transition-colors">
                    Bersihkan Pencarian
                </button>
            )}
        </div>
        <div className="overflow-x-auto p-4 bg-slate-50/30">
          <table className="w-full text-sm text-left border-collapse bg-white border border-slate-200 rounded-xl overflow-hidden">
            <thead className="text-[11px] text-slate-500 font-bold bg-slate-100/50 border-b border-slate-200 uppercase tracking-wider">
              <tr><th className="px-5 py-3">Nama Dokumen</th><th className="px-5 py-3">Format</th><th className="px-5 py-3">Tanggal</th><th className="px-5 py-3 text-center">Aksi</th></tr>
              <tr className="bg-slate-50/50 border-t border-slate-100">
                  <th className="px-3 py-2"><input type="text" placeholder="Cari nama..." className="w-full px-2 py-1.5 text-xs border border-slate-200 rounded-md outline-none focus:border-blue-400 font-medium shadow-sm" value={tableFilters.nama} onChange={e => setTableFilters({...tableFilters, nama: e.target.value})} /></th>
                  <th className="px-3 py-2"><input type="text" placeholder="Cari format..." className="w-full px-2 py-1.5 text-xs border border-slate-200 rounded-md outline-none focus:border-blue-400 font-medium shadow-sm" value={tableFilters.format} onChange={e => setTableFilters({...tableFilters, format: e.target.value})} /></th>
                  <th className="px-3 py-2"><input type="text" placeholder="Cari tanggal..." className="w-full px-2 py-1.5 text-xs border border-slate-200 rounded-md outline-none focus:border-blue-400 font-medium shadow-sm" value={tableFilters.tanggal} onChange={e => setTableFilters({...tableFilters, tanggal: e.target.value})} /></th>
                  <th className="px-3 py-2"></th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-100">
              {filteredDocs.length > 0 ? filteredDocs.map((doc) => (
                <tr key={doc.id} className="hover:bg-slate-50 transition-colors">
                  <td className="px-5 py-3.5 font-bold text-slate-800">{doc.title}</td>
                  <td className="px-5 py-3.5 text-xs text-slate-600 font-medium">{doc.fileName}</td>
                  <td className="px-5 py-3.5 text-xs text-slate-500 font-medium">{new Date(doc.uploadDate).toLocaleDateString('id-ID')}</td>
                  <td className="px-5 py-3.5 flex items-center justify-center space-x-2">
                    <a href={doc.fileData} target="_blank" rel="noopener noreferrer" className="p-1.5 text-blue-600 bg-white border border-slate-200 rounded-lg hover:bg-blue-50 shadow-sm"><Eye className="w-4 h-4" /></a>
                    <a href={doc.fileData} download={doc.fileName} className="p-1.5 text-emerald-600 bg-white border border-slate-200 rounded-lg hover:bg-emerald-50 shadow-sm"><Download className="w-4 h-4" /></a>
                    {userRole === 'admin' && <button onClick={() => handleDelete(doc.id, doc.title)} className="p-1.5 text-rose-500 bg-white border border-slate-200 rounded-lg hover:bg-rose-50 shadow-sm"><Trash2 className="w-4 h-4" /></button>}
                  </td>
                </tr>
              )) : <tr><td colSpan="4" className="px-6 py-8 text-center text-slate-400 font-medium text-sm">Tidak ada dokumen.</td></tr>}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
};

const GlobalDocumentBackupView = ({ user, userRole }) => {
  const [documents, setDocuments] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const restoreInputRef = useRef(null);
  const [notification, setNotification] = useState({ show: false, message: '', type: 'info' });

  useEffect(() => {
    if (!user) return;
    setIsLoading(true);
    const docsRef = collection(db, 'artifacts', safeAppId, 'public', 'data', 'documents');
    const unsubscribe = onSnapshot(docsRef, (snapshot) => {
      const fetchedData = snapshot.docs.map(doc => ({ ...doc.data(), id: doc.id }));
      setDocuments(fetchedData); setIsLoading(false);
    }, () => setIsLoading(false));
    return () => unsubscribe();
  }, [user]);

  const showNotification = (message, type = 'success') => { setNotification({ show: true, message, type }); setTimeout(() => setNotification({ show: false, message: '', type: 'info' }), 4000); };

  const handleBackup = () => {
      if (documents.length === 0) return showNotification("Tidak ada dokumen untuk dibackup.", "error");
      const url = URL.createObjectURL(new Blob([JSON.stringify(documents, null, 2)], { type: 'application/json' }));
      const link = document.createElement('a'); link.href = url; link.download = `Backup_Dokumen_Legal_${new Date().toISOString().split('T')[0]}.json`;
      document.body.appendChild(link); link.click(); document.body.removeChild(link); URL.revokeObjectURL(url);
      showNotification("Semua dokumen berhasil diekspor.", "success");
  };

  const handleRestoreFileChange = (e) => {
      const file = e.target.files[0]; if (!file) return;
      const reader = new FileReader();
      reader.onload = async (event) => {
          try {
              const importedData = JSON.parse(event.target.result);
              if (Array.isArray(importedData)) {
                  for (const d of importedData) await setDoc(doc(db, 'artifacts', safeAppId, 'public', 'data', 'documents', d.id.toString()), d);
                  showNotification(`Berhasil memulihkan ${importedData.length} dokumen.`, "success");
              } else showNotification("Format JSON tidak sesuai.", "error");
          } catch (error) { showNotification("Kesalahan membaca file.", "error"); }
      };
      reader.readAsText(file); e.target.value = '';
  };

  return (
    <div className="max-w-4xl mx-auto animate-in fade-in duration-300 pb-12">
      <div className="bg-white p-8 rounded-2xl shadow-[0_2px_12px_-4px_rgba(0,0,0,0.04)] border border-slate-200/60 text-center">
         <div className="w-16 h-16 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-5 border border-blue-100 shadow-sm"><Database className="w-8 h-8" /></div>
         <h1 className="text-2xl font-bold text-slate-800 tracking-tight mb-2">Backup & Restore Dokumen</h1>
         <p className="text-slate-500 text-sm mb-8 max-w-lg mx-auto leading-relaxed">Pusat pencadangan dan pemulihan tersentralisasi untuk semua data Dokumen Legal (SOP & WI, Form Standar, Seleksi, dan Evaluasi Supplier).</p>
         
         <div className="flex flex-col sm:flex-row justify-center gap-4">
             <button onClick={handleBackup} type="button" className="px-6 py-2.5 bg-white border border-slate-200 text-slate-700 rounded-xl hover:bg-slate-50 hover:text-blue-600 transition-colors shadow-sm font-bold text-sm flex items-center justify-center"><Download className="w-5 h-5 mr-2" /> Backup Data</button>
             {userRole === 'admin' && (
                 <>
                    <button onClick={() => restoreInputRef.current?.click()} type="button" className="px-6 py-2.5 bg-white border border-slate-200 text-slate-700 rounded-xl hover:bg-slate-50 hover:text-blue-600 transition-colors shadow-sm font-bold text-sm flex items-center justify-center"><Upload className="w-5 h-5 mr-2" /> Restore Data</button>
                    <input type="file" ref={restoreInputRef} onChange={handleRestoreFileChange} className="hidden" accept=".json" />
                 </>
             )}
         </div>

         {notification.show && <div className={`mt-6 p-4 rounded-xl inline-flex items-center shadow-sm border animate-in fade-in ${notification.type === 'success' ? 'bg-emerald-50 text-emerald-800 border-emerald-100' : 'bg-rose-50 text-rose-800 border-rose-100'}`}><span className="font-semibold text-sm">{notification.message}</span></div>}

         <div className="mt-10 pt-8 border-t border-slate-100 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div className="p-4 bg-slate-50 rounded-xl border border-slate-100"><div className="text-3xl font-extrabold text-blue-600 mb-1">{documents.filter(d => d.docType === 'sop').length}</div><div className="text-[11px] font-bold text-slate-500 uppercase tracking-wider">SOP & WI</div></div>
